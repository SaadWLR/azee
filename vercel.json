{
  "functions": {
    "api/cron/record-breadth.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/record-breadth",
      "schedule": "0 11 * * 1-5"
    }
  ],
  "rewrites": [
    {
      "source": "/api/market/commodities",
      "destination": "/api/market/pmex?feed=commodities"
    },
    {
      "source": "/api/market/global-futures",
      "destination": "/api/market/pmex?feed=global-futures"
    },
    {
      "source": "/api/market/watch",
      "destination": "/api/market/psx-watch?view=watch"
    },
    {
      "source": "/api/market/etfs",
      "destination": "/api/market/psx-watch?view=etfs"
    },
    {
      "source": "/api/calendar/agm",
      "destination": "/api/calendar/corporate?view=meetings"
    },
    {
      "source": "/api/payouts/latest",
      "destination": "/api/calendar/corporate?view=payouts"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://i.brecorder.com https://i.tribune.com.pk; media-src 'self' https://videos.pexels.com; connect-src 'self' https://*.ingest.us.sentry.io; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    }
  ]
}
